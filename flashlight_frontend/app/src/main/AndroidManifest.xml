<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Minimal permission that may be required on some devices to control torch -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Camera hardware marked optional to allow install on devices without camera -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Flash hardware marked optional so app remains installable on devices without flash -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.OceanProfessional">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OceanProfessional">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
