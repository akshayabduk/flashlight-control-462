<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Minimal permission required for potential torch control on some OEMs -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Declare camera hardware as optional to satisfy lint/play requirements -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Declare flash feature as optional so app installs on devices without flash -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.OceanProfessional">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OceanProfessional">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
